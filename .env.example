# ==============================================================================
# TrendMotion Studio - Environment Configuration Template
# NOTE: Copy this file to .env before starting the application.
# NEVER commit real credentials, API keys, or production secrets to Git.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="TrendMotion Studio API"
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL 16)
# Format: postgresql+psycopg://username:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://trendmotion_user:trendmotion_dev_pass@localhost:5432/trendmotion_db

# Redis Cache & Celery Message Broker
# Format: redis://[:password@]host:port/db_number
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated list of origins for Web Frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication & Security (JWT)
# Generate a secure 32+ character key for real environments: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (Local Filesystem Storage - Mandatory Architecture)
# Stored locally on the backend server; never use cloud/object storage
LOCAL_STORAGE_ROOT=./data/storage
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_VIDEO_UPLOAD_SIZE_BYTES=104857600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# AI Provider Adapters Configuration
# Supported image provider adapter stubs: mock | fal_ai | replicate
AI_IMAGE_PROVIDER=mock
# Supported video provider adapter stubs: mock | kling | runaway
AI_VIDEO_PROVIDER=mock
